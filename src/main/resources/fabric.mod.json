{
  "schemaVersion": 1,
  "id": "pokercraft",
  "version": "${version}",
  "name": "PokerCraft",
  "description": "Poker tables, playing cards, and chips. A foundation for multiplayer poker in Minecraft.",
  "authors": ["Brait"],
  "environment": "*",
  "entrypoints": {
    "main": ["com.brait.pokercraft.PokerCraft"],
    "client": ["com.brait.pokercraft.client.PokerCraftClient"]
  },
  "mixins": [
    {
      "config": "pokercraft.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "geckolib": ">=4.7.6 <5"
  }
}
